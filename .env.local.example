# Khoj local/deployment config — copy to .env.local and fill in.
# (scripts/start-local.sh writes this file for you after prompting.)
WEB_PORT=8080
AGENT_PORT=8090

# Data: SQLite db + (local backend) originals live under here.
KHOJ_DATA_DIR=./data
# Originals storage: local = disk, gcs = Google bucket (KHOJ_BUCKET).
KHOJ_STORAGE=local
KHOJ_BUCKET=

# Built-in auth: shared signing secret (web + agent MUST match) and the
# email that becomes platform super admin at sign-in.
KHOJ_AUTH_SECRET=change-me-to-a-long-random-string
KHOJ_SUPER_ADMIN_EMAIL=you@example.com

# OpenRAG (must already be running): local backend or the GKE app proxy.
OPENRAG_URL=http://localhost:8000

# Chat agent model (blank key = extractive answers).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Jira ticket button (blank token = feature off).
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
JIRA_API_TOKEN=
